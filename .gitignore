# 依赖
node_modules/

# 构建产物
dist/
dist-firefox/
release/
# PyInstaller 的中间目录（packaging/build.bat）。注意 .gitignore 里 # 只在行首
# 才是注释，写在模式后面会被当成目录名的一部分。
build/
*.spec.bak

# Python 缓存
__pycache__/
*.py[cod]

# IDE / 编辑器
.idea/
.vscode/
*.iml

# 系统文件
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
*.tmp
.saved_web/
.scratch/
docs/

# 用户点名的导出物（`python -m boss_filter export --out filters.json` 的示例名）
filters.json

# 设计过程产物（surface brief / review 截图 / build state），不发到浏览器
.impeccable/

# 真浏览器配置（CDP 取 __zp_stoken__ 用，动了 Chrome 就废）
.chrome_profile/

# 职位库旧档 / 回滚副本（数据已进 data/boss.db，核对后自行删）
jobs.db
jobs.db.migrated

# Web 控制台运行时数据（状态库 boss.db 所在处；llm_config 之类的旧账本也落在这里面）
data/
